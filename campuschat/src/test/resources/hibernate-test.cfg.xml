<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
        <!-- H2 In-Memory Database for fast testing -->
        <property name="hibernate.connection.driver_class">org.h2.Driver</property>
        <property name="hibernate.connection.url">jdbc:h2:mem:campuschat_test;DB_CLOSE_DELAY=-1;MODE=MySQL;DATABASE_TO_LOWER=TRUE;NON_KEYWORDS=YEAR</property>
        <property name="hibernate.connection.username">sa</property>
        <property name="hibernate.connection.password"></property>
        <property name="hibernate.auto_quote_keyword">true</property>

        <!-- Dialect for H2 -->
        <property name="hibernate.dialect">org.hibernate.dialect.H2Dialect</property>

        <property name="hibernate.show_sql">false</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Auto-generate schema for test suite -->
        <property name="hibernate.hbm2ddl.auto">create-drop</property>

        <!-- Entity Mappings -->
        <mapping class="com.campuschat.model.Batch"/>
        <mapping class="com.campuschat.model.User"/>
        <mapping class="com.campuschat.model.UserSession"/>
        <mapping class="com.campuschat.model.Message"/>
        <mapping class="com.campuschat.model.MessageQueue"/>
        <mapping class="com.campuschat.model.EmailVerification"/>
    </session-factory>
</hibernate-configuration>
